# Local Terraform working state - never committed, regenerated by `init`.
# .terraform.lock.hcl is NOT excluded here, deliberately - unlike the
# provider binaries in .terraform/, the lock file pins exact provider
# versions/checksums and should be committed for reproducible applies.
**/.terraform/

# State files - the whole point of the S3 backend is that these live
# there, not in git. A committed .tfstate would contain every resource's
# full attributes, including the master DB passwords this project
# otherwise goes out of its way to keep in Secrets Manager instead.
*.tfstate
*.tfstate.*

# Per-environment secrets/config - .example files are the template,
# real values are never committed.
*.tfvars
!*.tfvars.example
backend.hcl
!backend.hcl.example

crash.log
crash.*.log

.DS_Store
